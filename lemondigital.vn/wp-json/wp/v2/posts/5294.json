h\u1ea9m \u1edf v\u1ecb tr\u00ed g\u1ecdn g\u00e0ng, trong t\u1ea7m v\u1edbi \u0111\u1ec3 b\u1ea1n c\u00f3 th\u1ec3 d\u1ec5 d\u00e0ng l\u1ea5y v\u00e0 gi\u1edbi thi\u1ec7u m\u1ed9t c\u00e1ch m\u01b0\u1ee3t m\u00e0.<\/div>\n<\/li>\n<\/ul>\n<p>&nbsp;<\/p>\n<ol class=\"ace-line ace-line old-record-id-XVWJd6opdocCuOxB76elnYJTgrf\" start=\"3\">\n<li data-list=\"number\">\n<h3 class=\"heading-3\">Chu\u1ea9n b\u1ecb n\u1ed9i dung<\/h3>\n<\/li>\n<\/ol>\n<\/div>\n<div class=\"image-uploaded gallery old-record-id-ZFamdHgBpo8WHvxFsUglhalqgnd\" data-type=\"image\" data-ace-gallery-json=\"{&quot;items&quot;:[{&quot;uuid&quot;:&quot;cb1e4082-dca0-401a-8d4f-e6d6040b3ec2&quot;,&quot;height&quot;:628,&quot;width&quot;:1200,&quot;currHeight&quot;:628,&quot;currWidth&quot;:1200,&quot;natrualHeight&quot;:628,&quot;natrualWidth&quot;:1200,&quot;pluginName&quot;:&quot;imageUpload&quot;,&quot;scale&quot;:1,&quot;src&quot;:&quot;https%3A%2F%2Finternal-api-drive-stream-sg.larksuite.com%2Fspace%2Fapi%2Fbox%2Fstream%2Fdownload%2Fpreview%2FE1QwbVhxtohWrHx6QLIll4pygde%2F%3Fpreview_type%3D16&quot;,&quot;file_token&quot;:&quot;E1QwbVhxtohWrHx6QLIll4pygde&quot;,&quot;image_type&quot;:&quot;image\/png&quot;,&quot;size&quot;:422429,&quot;comments&quot;:[]}]}\">\u00a0<\/div>\n<div data-type=\"image\" data-ace-gallery-json=\"{&quot;items&quot;:[{&quot;uuid&quot;:&quot;cb1e4082-dca0-401a-8d4f-e6d6040b3ec2&quot;,&quot;height&quot;:628,&quot;width&quot;:1200,&quot;currHeight&quot;:628,&quot;currWidth&quot;:1200,&quot;natrualHeight&quot;:628,&quot;natrualWidth&quot;:1200,&quot;pluginName&quot;:&quot;imageUpload&quot;,&quot;scale&quot;:1,&quot;src&quot;:&quot;https%3A%2F%2Finternal-api-drive-stream-sg.larksuite.com%2Fspace%2Fapi%2Fbox%2Fstream%2Fdownload%2Fpreview%2FE1QwbVhxtohWrHx6QLIll4pygde%2F%3Fpreview_type%3D16&quot;,&quot;file_token&quot;:&quot;E1QwbVhxtohWrHx6QLIll4pygde&quot;,&quot;image_type&quot;:&quot;image\/png&quot;,&quot;size&quot;:422429,&quot;comments&quot;:[]}]}\">\n<figure id=\"attachment