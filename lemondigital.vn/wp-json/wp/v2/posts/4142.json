":{"rendered":"<p>TikTok l\u00e0 m\u1ed9t trong nh\u1eefng n\u1ec1n t\u1ea3ng m\u1ea1ng x\u00e3 h\u1ed9i ph\u00e1t tri\u1ec3n nhanh hi\u1ec7n nay, kh\u00f4ng ch\u1ec9 ph\u1ed5 bi\u1ebfn v\u1edbi video ng\u1eafn m\u00e0 c\u00f2n m\u1edf r\u1ed9ng sang l\u0129nh v\u1ef1c th\u01b0\u01a1ng m\u1ea1i \u0111i\u1ec7n t\u1eed qua TikTok Shop. N\u1ec1n t\u1ea3ng n\u00e0y h\u1ee3p t\u00e1c v\u1edbi nhi\u1ec1u \u0111\u1ed1i t\u00e1c nh\u1eb1m h\u1ed7 tr\u1ee3 ng\u01b0\u1eddi b\u00e1n, qu\u1ea3ng b\u00e1 s\u1ea3n ph\u1ea9m v\u00e0 [&hellip;]<\/p>\n","protected":false},"author":5,"featured_media":4761,"comment_status":"open","ping_status":"open","sticky":false,"template":"","format":"standard","meta":{"footnotes":""},"categories":[1],"tags":[],"class_list":["post-4142","post","type-post","status-publish","format-standard","has-post-thumbnail","hentry","category-tin-tuc"],"_links":{"self":[{"href":"https:\/\/lemondigital.vn\/wp-json\/wp\/v2\/posts\/4142","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/lemondigital.vn\/wp-json\/wp\/v2\/posts"}],"about":[{"href":"https:\/\/lemondigital.vn\/wp-json\/wp\/v2\/types\/post"}],"author":[{"embeddable":true,"href":"https:\/\/lemondigital.vn\/wp-json\/wp\/v2\/users\/5"}],"replies":[{"embeddable":true,"href":"https:\/\/lemondigital.vn\/wp-json\/wp\/v2\/comments?post=4142"}],"version-history":[{"count":16,"href":"https:\/\/lemondigital.vn\/wp-json\/wp\/v2\/posts\/4142\/revisions"}],"predecessor-version":[{"id":5220,"href":"https:\/\/lemondigital.vn\/wp-json\/wp\/v2\/posts\/4142\/revisions\/5220"}],"wp:featuredmedia":[{"embeddable":true,"href":"https:\/\/lemondigital.vn\/wp-json\/wp\/v2\/media\/4761"}],"wp:attachment":[{"href":"https:\/\/lemondigital.vn\/wp-json\/wp\/v2\/media?parent=4142"}],"wp:term":[{"taxonomy":"category","embeddable":true,"href":"https:\/\/lemondigital.vn\/wp-json\/wp\/v2\/categories?post=4142"},{"taxonomy":"post_tag","embeddable":true,"href":"https:\/\/lemondigital.vn\/wp-json\/wp\/v2\/tags?post=4142"}],