e7a b\u1ea1n l\u00ean xu h\u01b0\u1edbng, ti\u1ebfp [&hellip;]<\/p>\n","protected":false},"author":5,"featured_media":4750,"comment_status":"open","ping_status":"open","sticky":false,"template":"","format":"standard","meta":{"footnotes":""},"categories":[29,1],"tags":[],"class_list":["post-3972","post","type-post","status-publish","format-standard","has-post-thumbnail","hentry","category-kien-thuc-tiktok","category-tin-tuc"],"_links":{"self":[{"href":"https:\/\/lemondigital.vn\/wp-json\/wp\/v2\/posts\/3972","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/lemondigital.vn\/wp-json\/wp\/v2\/posts"}],"about":[{"href":"https:\/\/lemondigital.vn\/wp-json\/wp\/v2\/types\/post"}],"author":[{"embeddable":true,"href":"https:\/\/lemondigital.vn\/wp-json\/wp\/v2\/users\/5"}],"replies":[{"embeddable":true,"href":"https:\/\/lemondigital.vn\/wp-json\/wp\/v2\/comments?post=3972"}],"version-history":[{"count":11,"href":"https:\/\/lemondigital.vn\/wp-json\/wp\/v2\/posts\/3972\/revisions"}],"predecessor-version":[{"id":5177,"href":"https:\/\/lemondigital.vn\/wp-json\/wp\/v2\/posts\/3972\/revisions\/5177"}],"wp:featuredmedia":[{"embeddable":true,"href":"https:\/\/lemondigital.vn\/wp-json\/wp\/v2\/media\/4750"}],"wp:attachment":[{"href":"https:\/\/lemondigital.vn\/wp-json\/wp\/v2\/media?parent=3972"}],"wp:term":[{"taxonomy":"category","embeddable":true,"href":"https:\/\/lemondigital.vn\/wp-json\/wp\/v2\/categories?post=3972"},{"taxonomy":"post_tag","embeddable":true,"href":"https:\/\/lemondigital.vn\/wp-json\/wp\/v2\/tags?post=3972"}],"curies":[{"name":"wp","href":"https:\/\/api.w.org\/{rel}","templated":true}]}}